# Database (Prisma / PostgreSQL)
# Pooled URL for the app, direct (non-pooler) URL for Prisma CLI migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/better-auth?schema=public"
DIRECT_URL=""

# Authentication (Better Auth)
# Use a long random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional override; defaults to the test premium price id in lib/stripe.ts
STRIPE_PREMIUM_PRICE_ID=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
